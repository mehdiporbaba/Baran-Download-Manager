{
  "name": "baran-download-manager",
  "version": "1.0.0",
  "description": "Baran Download Manager — collect links, schedule downloads, and manage your connection.",
  "main": "./out/main/index.js",
  "author": "Mehdi Porbaba",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "test:network": "node tests/run-network.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "io.github.mehdiporbaba.baran",
    "productName": "Baran Download Manager",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Baran Download Manager",
      "artifactName": "Baran-Download-Manager-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Baran-Download-Manager-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "artifactName": "Baran-Download-Manager-${version}-${arch}.${ext}",
      "maintainer": "Pulse"
    }
  },
  "homepage": "https://github.com/mehdiporbaba/Baran-Download-Manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehdiporbaba/Baran-Download-Manager.git"
  }
}
